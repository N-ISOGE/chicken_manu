(* ================================================================== *)
(* BMS (Be-Music Script) File Format — EBNF Grammar Specification     *)
(* ================================================================== *)
(* Notation : W3C XML 1.1 EBNF                                        *)
(*            https://www.w3.org/TR/2006/REC-xml11-20060816/#sec-notation *)
(*                                                                    *)
(* References:                                                         *)
(*   - hitkey BMS command memo                                         *)
(*     https://hitkey.nekokan.dyndns.info/cmds.htm                     *)
(*   - BM98 Format Specification                                       *)
(*     https://bm98.yaneu.com/bm98/bmsformat.html                     *)
(*   - UTR#17: Unicode Character Encoding Model                        *)
(*     https://www.unicode.org/reports/tr17/                           *)
(*   - RFC 2978: IANA Charset Registration Procedures                  *)
(*     https://www.rfc-editor.org/rfc/rfc2978                         *)
(*   - W3C XML 1.1 §4.3.3: Character Encoding in Entities             *)
(*     https://www.w3.org/TR/2006/REC-xml11-20060816/#charencoding    *)
(* ================================================================== *)


(* ================================================================== *)
(* §0. 문자 인코딩 모델 (Character Encoding Model)                    *)
(*                                                                    *)
(* 이 명세는 UTR#17 "Unicode Character Encoding Model" 에서 정의한    *)
(* 5계층 모델을 BMS 파일 형식에 적용한다.                             *)
(*                                                                    *)
(* ┌──────────────────────────────────────────────────────────────┐  *)
(* │             UTR#17 5-Layer Encoding Model                    │  *)
(* ├──────────────────────────────────────────────────────────────┤  *)
(* │ Layer        이름                        역할                 │  *)
(* ├──────────────────────────────────────────────────────────────┤  *)
(* │ ACR   Abstract Character Repertoire  추상 문자 집합           │  *)
(* │       BMS에서: 제목·아티스트·장르 등 필드에 쓰이는 문자들     │  *)
(* │                                                              │  *)
(* │ CCS   Coded Character Set            문자 → 코드 포인트 매핑  │  *)
(* │       BMS에서: 유니코드(ISO/IEC 10646)의 코드 포인트 공간     │  *)
(* │       ★ 이 문법이 동작하는 계층 ★                            │  *)
(* │                                                              │  *)
(* │ CEF   Character Encoding Form        코드 포인트 → 코드 유닛  │  *)
(* │       (UTF-8: 1–4바이트, UTF-16: 1–2워드, UTF-32: 고정 4바이트)│  *)
(* │                                                              │  *)
(* │ CES   Character Encoding Scheme      코드 유닛 → 바이트 열   │  *)
(* │       (엔디언 처리 포함; UTF-16BE/LE, UTF-32BE/LE 등)         │  *)
(* │                                                              *)
(* │ TES   Transfer Encoding Syntax       바이트 → 전송 형식       │  *)
(* │       (base64 등; BMS에서는 적용 없음)                        │  *)
(* ├──────────────────────────────────────────────────────────────┤  *)
(* │ CM    Character Map                  ACR → 바이트 열 통합 매핑│  *)
(* │       IANA charset 이름이 CM에 해당한다 (RFC 2978)            │  *)
(* │       예: "UTF-8", "Shift_JIS", "EUC-KR"                     │  *)
(* └──────────────────────────────────────────────────────────────┘  *)
(*                                                                    *)
(* 이 EBNF는 CCS(코드 포인트) 레벨에서 정의된다.                     *)
(* CEF + CES = CM 에 해당하는 바이트↔코드포인트 변환은               *)
(* 파서가 문법 외부에서 수행하며, 아래 우선순위로 CM을 결정한다:     *)
(*                                                                    *)
(*   1. #CHARSET 헤더 값을 IANA charset 이름으로 해석 (CM 지정)      *)
(*      예: #CHARSET UTF-8  →  UTF-8 Character Map 적용              *)
(*      예: #CHARSET Shift_JIS  →  Shift_JIS Character Map 적용      *)
(*   2. 파일 선두 BOM(Byte Order Mark) 감지 (아래 표 참조)           *)
(*   3. 위 두 단서가 모두 없으면 구현 의존                           *)
(*      (역사적으로 일본 BMS는 Shift_JIS, 한국 BMS는 EUC-KR/UTF-8)  *)
(*                                                                    *)
(* BOM 감지 우선순위 (W3C XML 1.1 §4.3.3 / UTR#17 §2.5 준거):       *)
(*   ┌─────────────────┬───────────────────────────────────────┐    *)
(*   │ 선두 바이트     │ 결정 인코딩                           │    *)
(*   ├─────────────────┼───────────────────────────────────────┤    *)
(*   │ EF BB BF        │ UTF-8  (BOM 포함)                     │    *)
(*   │ FF FE (00 00 ×) │ UTF-16 LE                             │    *)
(*   │ FE FF           │ UTF-16 BE                             │    *)
(*   │ FF FE 00 00     │ UTF-32 LE                             │    *)
(*   │ 00 00 FE FF     │ UTF-32 BE                             │    *)
(*   └─────────────────┴───────────────────────────────────────┘    *)
(*                                                                    *)
(* #CHARSET 헤더 값의 문법은 §5-1의 charset_name 규칙을 따른다.      *)
(* charset 이름은 RFC 2978 및 W3C XML 1.1 §4.3.3 EncName 규칙에    *)
(* 준거하며 대소문자를 구별하지 않는다 (case-insensitive).           *)
(*                                                                    *)
(* ------------------------------------------------------------------ *)
(*                                                                    *)
(* 3-계층 표현 모델:                                                  *)
(*                                                                    *)
(*   [바이트 계층]  실제 파일에 저장된 이진 표현 (CES/CEF 담당)       *)
(*        ↕  CM (Character Map = CEF + CES)                          *)
(*   [코드 포인트 계층]  유니코드 정수값 (이 EBNF가 동작하는 계층)    *)
(*        ↕  렌더링 규칙 (Unicode 정규화, 서체, 쉐이핑)               *)
(*   [글자 계층]  사용자가 인식하는 문자 (언어·서체에 종속)           *)
(*                                                                    *)
(* EBNF 규칙은 코드 포인트 계층에서만 정의한다.                      *)
(* 바이트 계층: 파서 전처리 (BOM·#CHARSET → CM 선택 → 디코드)        *)
(* 글자 계층 : 구현 권장 사항으로만 기술하며 문법 규칙에 포함 않음   *)
(* ================================================================== *)


(* ================================================================== *)
(* §0-1. 인코딩 선언 (Encoding Declaration)                          *)
(*                                                                    *)
(* charset_name은 IANA charset 이름 규칙을 따른다.                   *)
(* 형식: W3C XML 1.1 EncName   [A-Za-z] ([A-Za-z0-9._-])*           *)
(* 이 규칙은 문법 내에서 #CHARSET 헤더 값의 형식을 기술하기 위해     *)
(* 사용되며, 실제 CM 결정 로직은 파서가 담당한다.                     *)
(* ================================================================== *)

charset_name     ::= ASCII_ALPHA ( ASCII_ALNUM
                                 | [#x002E]      (* '.' U+002E  *)
                                 | [#x005F]      (* '_' U+005F  *)
                                 | [#x002D]      (* '-' U+002D  *)
                                 )*
                     (* IANA charset 이름. 대소문자 무관.              *)
                     (* 예: "UTF-8", "Shift_JIS", "EUC-KR",           *)
                     (*     "ISO-8859-1", "windows-1252"               *)
                     (* 미등록 인코딩은 "x-" 접두사 사용 권장          *)


(* ================================================================== *)
(* §1. 코드 포인트 정의 계층                                          *)
(*                                                                    *)
(* 계층 구조:                                                         *)
(*                                                                    *)
(*  [Layer 0] 제어 코드 포인트 (개별 범위로 직접 정의)               *)
(*      CP_NUL, CP_HT, CP_LF, CP_CR, CP_SP                          *)
(*      (CP_SURROGATE: UTF-16 내부 표현 전용 — 이 문법에서 사용 금지)*)
(*                                                                    *)
(*  [Layer 1] 인쇄 가능 코드 포인트 범위 (직접 범위 나열)            *)
(*      CP_ASCII_PRINT   U+0021–U+007E  (ASCII 출력, 공백 제외)      *)
(*      CP_HIGH_UNICODE  U+0080–U+D7FF  (비ASCII BMP 전반부)         *)
(*                       U+E000–U+FFFD  (PUA 및 BMP 나머지)          *)
(*                       U+10000–U+10FFFF (보조 평면)                *)
(*                                                                    *)
(*  [Layer 2] 문맥별 단말 집합 (Layer 0–1의 합성)                    *)
(*      ASCII_DIGIT, ASCII_UPPER, ASCII_LOWER                        *)
(*      PRINTABLE_ASCII  = CP_SP | CP_ASCII_PRINT                    *)
(*      NONASCII         = CP_HIGH_UNICODE                           *)
(*      LINE_CHAR        = PRINTABLE_ASCII | NONASCII  (줄바꿈 제외) *)
(*      PATH_CHAR        = CP_ASCII_PRINT  | NONASCII  (공백·탭 제외)*)
(*                                                                    *)
(*  [Layer 3] 어휘 규칙 (Layer 2의 합성)                             *)
(*      DIGIT, HEX_DIGIT, BASE36_DIGIT, ALPHA                        *)
(*      WSP, NL                                                       *)
(*      quoted_text, file_path, charset_name, ...                    *)
(* ================================================================== *)


(* ================================================================== *)
(* §1-0. Layer 0 : 제어 코드 포인트                                  *)
(* ================================================================== *)

CP_NUL           ::= #x0000              (* U+0000  NULL — BMS에 허용되지 않음  *)
CP_HT            ::= #x0009              (* U+0009  HORIZONTAL TAB               *)
CP_LF            ::= #x000A              (* U+000A  LINE FEED                    *)
CP_CR            ::= #x000D              (* U+000D  CARRIAGE RETURN              *)
CP_SP            ::= #x0020              (* U+0020  SPACE                        *)

(* 서로게이트: UTF-16 내부 표현 전용 코드 포인트 (U+D800–U+DFFF)      *)
(* CES/CEF 계층에서 UTF-16 디코딩 시 나타나는 중간 값이며,            *)
(* CCS(코드 포인트) 레벨에서는 유효한 유니코드 스칼라 값이 아니다.   *)
(* 이 문법의 어떤 규칙에도 나타나지 않으며 참조 목적으로만 기재한다: *)
(* CP_SURROGATE   ::= [#xD800-#xDFFF]   ← 사용 금지                  *)


(* ================================================================== *)
(* §1-1. Layer 1 : 인쇄 가능 코드 포인트 범위                        *)
(* ================================================================== *)

(* ASCII 출력 가능 범위 (공백 U+0020 제외)                           *)
CP_ASCII_PRINT   ::= [#x0021-#x007E]
                     (* U+0021 '!' ~ U+007E '~'                       *)

(* 비ASCII 유니코드 스칼라 값 — 서로게이트 쌍(U+D800–U+DFFF)과       *)
(* 비문자(U+FFFE, U+FFFF)를 제외한 세 구간                           *)
(*   구간 1: U+0080–U+D7FF  Latin 보충 ~ 한글 자모 끝                *)
(*   구간 2: U+E000–U+FFFD  PUA(사용자 지정 영역) ~ BMP 끝           *)
(*           U+FFFE·U+FFFF 는 유니코드 비문자(noncharacter)이므로 제외*)
(*   구간 3: U+10000–U+10FFFF  보조 평면 전체                        *)
CP_HIGH_UNICODE  ::= [#x0080-#xD7FF]
                   | [#xE000-#xFFFD]
                   | [#x10000-#x10FFFF]


(* ================================================================== *)
(* §1-2. Layer 2 : 문맥별 단말 집합                                  *)
(* ================================================================== *)

(* --- ASCII 소범주 (Layer 1의 하위 범위) -------------------------  *)

ASCII_DIGIT      ::= [#x0030-#x0039]     (* '0'–'9' *)
ASCII_UPPER      ::= [#x0041-#x005A]     (* 'A'–'Z' *)
ASCII_LOWER      ::= [#x0061-#x007A]     (* 'a'–'z' *)
ASCII_ALPHA      ::= ASCII_UPPER | ASCII_LOWER
ASCII_ALNUM      ::= ASCII_DIGIT | ASCII_UPPER | ASCII_LOWER

ASCII_HEX_UPPER  ::= [#x0041-#x0046]     (* 'A'–'F' *)
ASCII_HEX_LOWER  ::= [#x0061-#x0066]     (* 'a'–'f' *)

(* --- 인쇄 가능 ASCII (공백 포함) --------------------------------  *)
(*     = CP_SP | CP_ASCII_PRINT                                       *)

PRINTABLE_ASCII  ::= CP_SP               (* U+0020 *)
                   | CP_ASCII_PRINT      (* U+0021–U+007E *)

(* --- 비ASCII (보조 평면 포함) -----------------------------------  *)
(*     = CP_HIGH_UNICODE (서로게이트·비문자 제외)                    *)

NONASCII         ::= CP_HIGH_UNICODE     (* U+0080–U+D7FF            *)
                                         (* U+E000–U+FFFD            *)
                                         (* U+10000–U+10FFFF         *)

(* --- LINE_CHAR: 한 행 안에서 등장 가능한 모든 코드 포인트 ------  *)
(*     CCS 레벨 정의: 줄바꿈(CP_LF, CP_CR)과 NUL(CP_NUL)을 제외     *)
(*     탭(CP_HT)은 포함 — 일부 구현에서 헤더 구분자로 사용           *)
(*     비ASCII 문자(NONASCII)는 CM이 결정한 인코딩으로 디코딩된 후   *)
(*     코드 포인트로 이 규칙과 대조된다.                             *)
(*     = CP_HT | PRINTABLE_ASCII | NONASCII                          *)

LINE_CHAR        ::= CP_HT               (* U+0009 *)
                   | PRINTABLE_ASCII     (* U+0020–U+007E *)
                   | NONASCII           (* U+0080– (서로게이트 제외) *)

(* --- PATH_CHAR: 파일 경로를 구성하는 코드 포인트 ---------------  *)
(*     공백(CP_SP), 탭(CP_HT), 줄바꿈(CP_LF, CP_CR)을 제외          *)
(*     비ASCII 경로(한글·일본어 디렉터리 이름 등) 허용               *)
(*     = CP_ASCII_PRINT | NONASCII                                   *)
(*     주의: OS/FS 금지 문자(Win32: \ / : * ? " < > |)는            *)
(*           이 문법 외부에서 별도로 제약한다                        *)

PATH_CHAR        ::= CP_ASCII_PRINT      (* U+0021–U+007E *)
                   | NONASCII           (* U+0080– (서로게이트 제외) *)


(* ================================================================== *)
(* §1-3. Layer 3 : 어휘 규칙                                         *)
(* ================================================================== *)

(* --- ASCII 수치·식별자 (커맨드명·인덱스 등 ASCII 고정 문맥) ----  *)

DIGIT            ::= ASCII_DIGIT         (* '0'–'9' *)
HEX_DIGIT        ::= ASCII_DIGIT | ASCII_HEX_UPPER | ASCII_HEX_LOWER
BASE36_DIGIT     ::= ASCII_DIGIT | ASCII_UPPER | ASCII_LOWER
ALPHA            ::= ASCII_ALPHA

(* --- 공백·줄바꿈 -----------------------------------------------  *)

WSP              ::= CP_HT | CP_SP       (* U+0009 tab | U+0020 space *)
NL               ::= CP_CR? CP_LF        (* CRLF | LF                 *)
                   | CP_CR               (* CR 단독 (레거시)           *)
EOF              ::= (* end of input *)

(* --- 값 형식 토큰 ----------------------------------------------  *)

quoted_text      ::= LINE_CHAR*
                     (* CCS(코드 포인트) 레벨에서 줄바꿈 제외 전체 허용 *)
                     (* [글자 계층] 구현 권장:                         *)
                     (*   UTF-8 텍스트는 NFC 정규화 권장 (Unicode §3.11)*)
                     (*   Shift_JIS / EUC-KR 텍스트는 CM 변환 후 NFC   *)

file_path        ::= PATH_CHAR+
                     (* 공백·탭·줄바꿈을 제외한 경로 구성 문자        *)
                     (* 비ASCII 경로(한글·일본어 디렉터리 등) 허용;   *)
                     (* 구현 호환성을 위해 ASCII 경로를 권장한다       *)

integer          ::= '-'? DIGIT+
decimal          ::= '-'? DIGIT+ ( '.' DIGIT+ )?
bpm_value        ::= decimal             (* 양수; 소수점 허용          *)
stop_value       ::= integer             (* 1/192 마디 단위            *)


(* ================================================================== *)
(* §2. 주석                                                           *)
(*    세 가지 형식: "//" 행주석, ";" 행주석, "/* */" 블록주석         *)
(* ================================================================== *)

line_comment     ::= ( '//' | ';' ) LINE_CHAR* NL
                     (* 행 끝까지 임의의 코드 포인트 허용              *)
block_comment    ::= '/*' ( LINE_CHAR | NL )* '*/'
                     (* 블록 안에서 줄바꿈과 비ASCII 코드 포인트 허용  *)
comment          ::= line_comment | block_comment


(* ================================================================== *)
(* §3. 최상위 구조                                                    *)
(*    bms_file → bms_line*                                            *)
(* ================================================================== *)

bms_file         ::= ( bms_line | NL )* EOF
bms_line         ::= WSP* ( control_flow_stmt
                           | channel_stmt
                           | header_stmt
                           | seed_stmt
                           | comment
                           | non_command_line ) NL?

(* 제어흐름 구문을 포함하지 않는 단순 행 —                           *)
(* #RANDOM / #SWITCH 블록 내부에서 사용하여 중첩을 방지한다.         *)
(* control_flow_stmt(= random_block | switch_block | if_block)는     *)
(* random_body / case_clause / def_clause 에서 허용하지 않는다.      *)
simple_bms_line  ::= WSP* ( channel_stmt
                           | header_stmt
                           | seed_stmt
                           | comment
                           | non_command_line ) NL?

(* '#'으로 시작하지 않는 행 — 주석 또는 무시 대상; 비ASCII 허용      *)
(* 첫 문자가 '#'(U+0023)이 아닌 LINE_CHAR, 이후는 임의의 LINE_CHAR  *)
non_command_line ::= ( CP_HT
                     | CP_SP
                     | NONASCII
                     | [#x0021-#x0022]       (* '!' '\"' *)
                     | [#x0024-#x007E]       (* '$'–'~', '#'(#x23) 제외 *)
                     ) LINE_CHAR*


(* ================================================================== *)
(* §4. 인덱스 표기                                                    *)
(*    BM98 원본: hex 두 자리 (00-FF, 256개)                           *)
(*    현대 확장: base36 두 자리 (00-ZZ, 1296개)                       *)
(* ================================================================== *)

hex_index        ::= HEX_DIGIT HEX_DIGIT
base36_index     ::= BASE36_DIGIT BASE36_DIGIT
index            ::= base36_index        (* 상위 호환; hex_index ⊂ base36_index *)


(* ================================================================== *)
(* §5. 헤더 문장 (#COMMAND [value])                                   *)
(* ================================================================== *)

header_stmt      ::= '#' ( metadata_header
                         | file_header
                         | timing_header
                         | game_header
                         | gauge_header
                         | display_header
                         | misc_header )

(* --- §5-1. 메타데이터 -------------------------------------------  *)
(*     quoted_text 필드는 CCS(코드 포인트) 레벨에서 임의의 문자 허용 *)
(*     실제 인코딩(CM)은 #CHARSET 헤더 또는 BOM으로 결정             *)

metadata_header
  ::= 'TITLE'        WSP+ quoted_text
    | 'SUBTITLE'     WSP+ quoted_text
    | 'ARTIST'       WSP+ quoted_text
    | 'SUBARTIST'    WSP+ quoted_text
    | 'GENRE'        WSP+ quoted_text
    | 'MAKER'        WSP+ quoted_text
    | 'COMMENT'      WSP+ quoted_text
    | 'CHARSET'      WSP+ charset_name
      (* CM 결정에 사용되는 IANA charset 이름                         *)
      (* 이 헤더가 나타나면 파서는 전체 파일을 해당 CM으로 재해석한다 *)
      (* 위치 제약: 파일 선두 부근에 위치시키는 것을 강력히 권장      *)

(* --- §5-2. 파일 참조 --------------------------------------------  *)

file_header
  ::= 'WAV'          index WSP+ file_path
    | 'EXWAV'        index WSP+ LINE_CHAR+  (* 구현 의존적 확장 파라미터 *)
    | 'BMP'          index WSP+ file_path
    | 'EXBMP'        index WSP+ LINE_CHAR+
    | 'MIDIFILE'     WSP+ file_path
    | 'VIDEOFILE'    WSP+ file_path
    | 'MOVIE'        WSP+ file_path
    | 'PATH_WAV'     WSP+ file_path
    | 'STAGEFILE'    WSP+ file_path
    | 'BANNER'       WSP+ file_path
    | 'BACKBMP'      WSP+ file_path
    | 'CHARFILE'     WSP+ file_path
    | 'PREVIEW'      WSP+ file_path
    | 'CDDA'         WSP+ integer
    | 'MATERIALSWAV' WSP+ file_path
    | 'MATERIALSBMP' WSP+ file_path

(* --- §5-3. 타이밍 ----------------------------------------------  *)

timing_header
  ::= 'BPM'          ( index WSP+ bpm_value   (* #BPMxx — 확장 BPM 정의 *)
                     | WSP+ bpm_value )        (* #BPM   — 초기 BPM      *)
    | 'BASEBPM'      WSP+ bpm_value
    | 'STOP'         index WSP+ stop_value
    | 'SCROLL'       index WSP+ decimal

(* --- §5-4. 게임플레이 ------------------------------------------  *)

game_header
  ::= 'PLAYER'       WSP+ ( '1' | '2' | '3' | '4' )
    | 'RANK'         WSP+ ( '0' | '1' | '2' | '3' | '4' )
    | 'DEFEXRANK'    WSP+ integer
    | 'EXRANK'       index WSP+ integer
    | 'DIFFICULTY'   WSP+ ( '1' | '2' | '3' | '4' | '5' )
    | 'PLAYLEVEL'    WSP+ integer
    | 'LNTYPE'       WSP+ ( '1' | '2' )
    | 'LNOBJ'        WSP+ index
    | 'OPTION'       WSP+ quoted_text
    | 'CHANGEOPTION' index WSP+ quoted_text
    (* [1-4] 등의 범위 표기는 W3C XML 1.1 EBNF 비표준 — 명시적 열거로 대체 *)

(* --- §5-5. 게이지 / 볼륨 ---------------------------------------  *)

gauge_header
  ::= 'TOTAL'        WSP+ decimal
    | 'VOLWAV'       WSP+ integer

(* --- §5-6. 표시 / 영상 -----------------------------------------  *)

display_header
  ::= 'VIDEOf/s'     WSP+ decimal
    | 'VIDEODLY'     WSP+ integer

(* --- §5-7. 기타 ------------------------------------------------  *)

misc_header
  ::= '%URL'         WSP+ quoted_text
    | '%EMAIL'       WSP+ quoted_text


(* ================================================================== *)
(* §6. 제어흐름 블록 — RANDOM / IF / SWITCH / CASE 등                *)
(* ================================================================== *)

control_flow_stmt
  ::= random_block
    | switch_block
    | if_block_standalone        (* RANDOM/SWITCH 밖 단독 IF *)

(* --- §6-1. RANDOM 블록 -----------------------------------------  *)

random_block     ::= '#RANDOM'    WSP+ integer NL
                      random_body
                      '#ENDRANDOM' NL?

random_body      ::= ( if_block | simple_bms_line | NL )*
                     (* if_block 만 허용; random_block / switch_block 중첩 불가 *)

(* --- §6-2. IF 블록 ---------------------------------------------  *)

if_block         ::= '#IF'        WSP+ integer NL
                      ( bms_line | NL )*
                      ( '#ELSEIF'  WSP+ integer NL ( bms_line | NL )* )*
                      ( '#ELSE'    NL ( bms_line | NL )* )?
                      '#ENDIF'     NL?

if_block_standalone ::= if_block

(* --- §6-3. SWITCH 블록 -----------------------------------------  *)

switch_block     ::= '#SWITCH'    WSP+ integer NL
                      switch_body
                      '#ENDSW'     NL?

switch_body      ::= ( case_clause | def_clause | NL )*

case_clause      ::= '#CASE'      WSP+ integer NL
                      ( simple_bms_line | skip_stmt | NL )*
                      (* 제어흐름 중첩 방지: simple_bms_line 사용     *)

def_clause       ::= '#DEF'       NL
                      ( simple_bms_line | NL )*
                      (* 제어흐름 중첩 방지: simple_bms_line 사용     *)

skip_stmt        ::= '#SKIP' NL

(* --- §6-4. 시드 고정 -------------------------------------------  *)

seed_stmt        ::= '#SETRANDOM'  WSP+ integer NL
                   | '#SETSWITCH'  WSP+ integer NL


(* ================================================================== *)
(* §7. 채널 문장 — #aaa bb : data                                     *)
(*    aaa = 마디 번호 (000-999, 10진수)                              *)
(*    bb  = 채널 번호 (base36 두 자리)                               *)
(*    data = 오브젝트 배열 (인덱스 쌍의 나열)                        *)
(* ================================================================== *)

channel_stmt     ::= '#' measure_num WSP* channel_id WSP* ':' WSP* channel_data

measure_num      ::= DIGIT DIGIT DIGIT   (* 000 ~ 999 *)
channel_id       ::= BASE36_DIGIT BASE36_DIGIT

(* --- §7-1. 채널 데이터 형식 ------------------------------------  *)

channel_data     ::= object_array        (* 대부분의 채널 *)
                   | measure_length      (* 채널 02 전용  *)

object_array     ::= index+              (* 총 길이 ÷ 2 = 오브젝트 수 *)
measure_length   ::= decimal             (* 채널 02: 마디 길이 배수    *)

(* --- §7-2. 주요 채널 번호 일람 ---------------------------------  *)
(* 01     BGM (배경음; 다중 선언 가능)                               *)
(* 02     마디 길이 (소수; 기본값 1.0)                               *)
(* 03     BPM 변경 (hex 정수, 01-FF)                                 *)
(* 04     BGA base                                                   *)
(* 05     Extended object (BM98)                                     *)
(* 06     BGA poor                                                   *)
(* 07     BGA layer                                                  *)
(* 08     확장 BPM (#BPMxx 참조)                                     *)
(* 09     STOP 시퀀스 (#STOPxx 참조)                                 *)
(* 0A     BGA layer2                                                 *)
(*                                                                    *)
(* 11-19  1P visible (11-15=key1-5, 16=SC, 17=FREE, 18-19=key6-7)  *)
(* 21-29  2P visible                                                 *)
(* 31-39  1P invisible                                               *)
(* 41-49  2P invisible                                               *)
(* 51-59  1P long-note                                               *)
(* 61-69  2P long-note                                               *)
(* D1-D9  1P landmine                                                *)
(* E1-E9  2P landmine                                                *)
